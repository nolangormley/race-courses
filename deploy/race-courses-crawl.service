# The weekly crawl as a systemd user service; deploy/AGENTS.md has the setup.
[Unit]
Description=race-courses weekly crawl

[Service]
Type=oneshot
WorkingDirectory=%h/race-courses
ExecStartPre=/usr/bin/git fetch --quiet origin
ExecStartPre=/usr/bin/git reset --hard --quiet origin/main
ExecStart=%h/race-courses/deploy/weekly-crawl.sh
TimeoutStartSec=5h
Nice=10
